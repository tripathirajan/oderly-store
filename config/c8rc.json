{
  "all": true,
  "include": ["src/**/*.ts", "src/**/*.tsx", "config/runtime.config.mjs"],
  "exclude": [
    "src/shared/globals.d.ts",
    "src/client/index.tsx",
    "src/server/index.tsx",
    "src/server/cdn-index.ts",
    "src/server/metrics-index.ts"
  ],
  "reporter": ["text", "lcov", "html"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "branches": 75,
  "functions": 85,
  "lines": 90,
  "statements": 90
}
